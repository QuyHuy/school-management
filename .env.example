# ============================================================
# School Management — Environment Variables
# Copy this file to .env and fill in real values
# ============================================================

# ── Database ─────────────────────────────────────────────────
POSTGRES_USER=school
POSTGRES_PASSWORD=school
POSTGRES_DB=school
DATABASE_URL=postgresql+asyncpg://school:school@postgres:5432/school

# ── Redis ────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ── JWT ──────────────────────────────────────────────────────
JWT_SECRET_KEY=change-me-to-a-long-random-string-in-production
# access token expires in 15 minutes, refresh in 30 days

# ── Zalo Official Account ─────────────────────────────────────
ZALO_OA_ACCESS_TOKEN=your-zalo-oa-access-token
ZALO_OA_SECRET_KEY=your-zalo-oa-secret-key

# ── Frontend ─────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8080
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── CORS ─────────────────────────────────────────────────────
ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:8080"]

# ── Application ──────────────────────────────────────────────
ENVIRONMENT=development
DEBUG=true

# ── Monitoring ───────────────────────────────────────────────
SENTRY_DSN=
